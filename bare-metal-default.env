# Shared installer configuration for both bare-metal backends.
root_disk="${ROOT_DISK:?Set ROOT_DISK to the root disk device path}"
data_disk="${DATA_DISK:?Set DATA_DISK to the data disk device path}"
source_imgre=
target_imgref=
install_root=/run/bootc-metal-install/install-root
work_root=/run/bootc-metal-install
bootloader=grub
vol_list=(vol_root vol_boot vol_esp vol_var)
declare -A vol_root=(
    [action]=create
    [device]="$root_disk"
    [partition_number]=3
    [partition_size]=remainder
    [partition_type]=4f68bce3-e8cd-4db1-96e7-fbcaf984b709
    [partition_label]=root
    [mountpoint]=/
    [fs]=btrfs
    [fs_label]=root
    [mount_options]=compress=zstd,noatime
    [encryption]=luks-create
    [luks_name]=root
    [luks_label]=root_luks
    [credential]=ephemeral
    [tpm2]=true
    [tpm2_pcrs]=7
    [recovery]=true
    [subvol]=system/root
    [subvol_action]=create
)
declare -A vol_boot=(
    [action]=create
    [device]="$root_disk"
    [partition_number]=2
    [partition_size]=1024
    [partition_type]=bc13c2ff-59e6-4262-a352-b275fd6f7172
    [partition_label]=boot
    [mountpoint]=/boot
    [fs]=ext4
    [fs_label]=boot
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [subvol_action]=none
)
declare -A vol_esp=(
    [action]=create
    [device]="$root_disk"
    [partition_number]=1
    [partition_size]=600
    [partition_type]=ef00
    [partition_label]=boot_efi
    [mountpoint]=/boot/efi
    [fs]=vfat
    [fs_label]=boot_efi
    [mount_options]=defaults
    [encryption]=none
    [credential]=none
    [subvol_action]=none
)
declare -A vol_var=(
    [action]=create
    [device]="$data_disk"
    [mountpoint]=/var
    [fs]=btrfs
    [fs_label]=var
    [mount_options]=compress=zstd,noatime
    [encryption]=luks-create
    [luks_name]=var_crypt
    [luks_label]=var_luks
    [credential]=ephemeral
    [tpm2]=true
    [tpm2_pcrs]=7
    [recovery]=true
    [subvol]=var
    [subvol_action]=create
)
recovery_key_output_file=/run/bootc-metal-install/recovery-keys.txt
extra_kargs=(console=tty0 console=ttyS0,115200n8 console=ttyS1,115200n8)
user_name=test-admin
user_gecos='Test Administrator'
user_shell=/bin/bash
user_password_hash='$6$test-admin$QW3UNpO4IxVQ0qpn8zdce2/0oFzluylL3jPVmiumQKZKnv8RiKcMb6a3I0sftDPYi4pgDkw0iOGQhMeU4Q.fj.'
